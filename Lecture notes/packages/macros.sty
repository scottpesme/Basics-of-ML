% NB: do NOT redefine \span. It is a TeX primitive that amsmath uses when it
% builds the preamble of align/aligned/split, so overwriting it makes every such
% environment fail with "Missing # inserted in alignment preamble". Hence \spn.
\newcommand{\spn}{\operatorname{span}}
\newcommand{\rank}{\operatorname{rank}}
\newcommand{\Var}{\operatorname{Var}}
\DeclareMathOperator*{\argmin}{argmin}
\DeclareMathOperator*{\argmax}{argmax}
\newcommand{\note}[1]{{\textbf{\color{red}#1}}}
\newcommand{\diag}{\mathop{\rm diag}}
\newcommand{\Diag}{\mathop{\rm Diag}}
